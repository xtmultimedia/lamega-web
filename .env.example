# ── Stream ─────────────────────────────────────────────────────────────────────
# URL HTTPS del proxy FastCast4U (evita mixed-content en sitios HTTPS)
STREAM_URL=https://usa3.fastcast4u.com/proxy/lamega?mp=/stream
NEXT_PUBLIC_STREAM_URL=https://usa3.fastcast4u.com/proxy/lamega?mp=/stream

# ── API de automatización (app Python) ────────────────────────────────────────
# Header requerido: X-Radio-API-Key
# Genera con: openssl rand -hex 32
RADIO_API_KEY=changeme_generate_a_secure_key

# ── Base de datos ──────────────────────────────────────────────────────────────
# Dev (SQLite):    DATABASE_URL=file:./dev.db
# Prod (PostgreSQL o MySQL): cambia también provider en prisma/schema.prisma
DATABASE_URL=file:./dev.db

# ── Dashboard admin ────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# ── Email (leads comerciales vía Resend) ───────────────────────────────────────
# Si RESEND_API_KEY está vacío, el email se omite con un warning en consola
EMAIL_FROM=noreply@lamegaecuador.com
EMAIL_TO_COMERCIAL=comercial@lamegaecuador.com
RESEND_API_KEY=

# ── Auth (NextAuth.js) ─────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32  — NUNCA reusar entre entornos
NEXTAUTH_SECRET=
# URL pública del sitio (con https:// en producción)
NEXTAUTH_URL=http://localhost:3000
